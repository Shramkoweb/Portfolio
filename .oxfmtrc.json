{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "trailingComma": "all",
  "singleQuote": true,
  "printWidth": 80,
  "sortImports": true,
  "sortPackageJson": true,
  "ignorePatterns": [
    ".next/**",
    ".next-visual/**",
    "playwright-report/**",
    "test-results/**",
    "out/**",
    "build/**",
    "coverage/**",
    "prisma/migrations/**",
    "public/**",
    "next-env.d.ts"
  ]
}
